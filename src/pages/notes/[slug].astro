---
import { render } from "astro:content";
import InfoLayout from "../../layouts/InfoLayout.astro";
import { apps } from "../../data/apps";
import { site } from "../../data/site";
import { getNotesByApp, getSortedNotes, getTagGroups } from "../../lib/notes";
export async function getStaticPaths() {
  const notes = await getSortedNotes();
  return notes.map(note => ({ params: { slug: note.id }, props: { note } }));
}
const { note } = Astro.props;
const { Content } = await render(note);
const tagLinks = (await getTagGroups()).filter(group => note.data.tags.includes(group.tag));
const app = apps.find(item => item.id === note.data.app);
const moreNotes = app ? (await getNotesByApp(app.id)).filter(item => item.id !== note.id).slice(0, 3) : [];
const formatDate = (date: Date) => date.toLocaleDateString("ko-KR", { year: "numeric", month: "long", day: "numeric", timeZone: "Asia/Seoul" });
const structuredData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: note.data.title,
  description: note.data.description,
  inLanguage: "ko",
  datePublished: note.data.pubDate.toISOString(),
  dateModified: (note.data.updatedDate ?? note.data.pubDate).toISOString(),
  author: { "@type": "Person", name: site.operator, url: site.githubUrl },
  publisher: { "@type": "Organization", name: site.name, url: site.url },
  mainEntityOfPage: new URL(`/notes/${note.id}/`, site.url).toString(),
};
---
<InfoLayout title={note.data.title} description={note.data.description} eyebrow="STILL CODING / NOTES" translated={false} ogType="article">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="policy-meta note-byline"><span>{site.operator}</span><time datetime={note.data.pubDate.toISOString()}>{formatDate(note.data.pubDate)}</time>{note.data.updatedDate && <span>업데이트 {formatDate(note.data.updatedDate)}</span>}{note.data.draft && <span class="draft-badge">초안</span>}</div>
  {tagLinks.length > 0 && <ul class="note-tag-links" aria-label="주제">{tagLinks.map(({ tag, slug }) => <li><a href={`/notes/tag/${slug}/`}>{tag}</a></li>)}</ul>}
  <article class="note-body"><Content /></article>
  <aside class="note-footer">
    {app && <>
      <p class="note-footer-label">이 글에서 다룬 앱</p>
      <p><strong>{app.title}</strong> — {app.summary}</p>
      <div class="detail-actions">
        {app.url && <a class="primary-link" href={app.url} target="_blank" rel="noopener noreferrer">앱 열기 <span aria-hidden="true">↗</span></a>}
        {note.data.game && <a class="secondary-link" href={`https://dp.still-coding.cc/games/${note.data.game}/`} target="_blank" rel="noopener noreferrer">이 게임의 방법 보기 ↗</a>}
        <a class="secondary-link" href={`/apps/${app.id}/`}>{app.title} 소개</a>
        <a class="secondary-link" href={`/notes/app/${app.id}/`}>{app.title} 개발 노트 전체</a>
      </div>
      {moreNotes.length > 0 && <>
        <p class="note-footer-label">같은 앱의 다른 노트</p>
        <ul class="detail-notes">{moreNotes.map(item => <li><a class="text-link" href={`/notes/${item.id}/`}>{item.data.title}</a><p>{item.data.description}</p></li>)}</ul>
      </>}
    </>}
    <p><a class="secondary-link" href="/notes/">모든 노트 보기</a></p>
  </aside>
</InfoLayout>
