---
import InfoLayout from "../../layouts/InfoLayout.astro";
import { getCollection } from "astro:content";
import { apps } from "../../data/apps";
export function getStaticPaths() {
  return apps.filter(app => app.status === "public").map(app => ({ params: { slug: app.id }, props: { app } }));
}
const { app } = Astro.props;
const relatedNotes = (await getCollection("notes")).filter(note => note.data.app === app.id);
---
<InfoLayout title={app.title} description={`${app.title} — ${app.summary}`} eyebrow={`STILL CODING / WORK ${String(app.order).padStart(2, "0")}`}>
  <div class="app-detail-hero" style={`--detail-accent:${app.accent}`}><div><p class="detail-eyebrow">{app.eyebrow}</p><p class="detail-summary">{app.summary}</p><p>{app.detail}</p></div><div class="detail-actions">{app.url && <a class="primary-link" href={app.url} target="_blank" rel="noopener noreferrer">앱 열기 <span aria-hidden="true">↗</span></a>}{app.helpUrl && <a class="secondary-link" href={app.helpUrl} target="_blank" rel="noopener noreferrer">사용법 열기 <span aria-hidden="true">↗</span></a>}<a class="secondary-link" href="/">모든 작업 보기</a></div></div>
  {app.id === "guitar-auto-strum" && <section class="detail-section demo-section"><p class="section-number">00 / SEE IT PLAY</p><h2>11초로 보는<br /><em>사용법.</em></h2><video class="detail-demo-video" src="/videos/guitar-demo.mp4" poster="/images/apps/guitar/demo-poster.jpg" controls muted loop playsinline preload="metadata" aria-label="코드 버튼을 누르면 자동 스트럼이 이어지고 지판에 코드가 표시되는 시연 영상"></video><p class="demo-caption">코드 버튼(C · G · Am · F)만 누르면 리듬은 앱이 이어 칩니다. 위쪽 지판에 지금 누르는 코드의 운지가 표시됩니다. 소리를 들으려면 영상의 음소거를 해제하세요.</p></section>}
  <section class="detail-section"><p class="section-number">01 / FOR WHOM</p><h2>누구를 위한<br /><em>도구인가요?</em></h2><p>{app.audience}</p></section>
  <section class="detail-section"><p class="section-number">02 / START IN THREE STEPS</p><h2>처음이라면<br /><em>이렇게 시작하세요.</em></h2><ol class="step-list">{app.steps.map((step, index) => <li><span>0{index + 1}</span><p>{step}</p></li>)}</ol></section>
  <section class="detail-section"><p class="section-number">03 / DATA & LIMITS</p><h2>사용 전에<br /><em>알아둘 것.</em></h2><p>{app.dataPolicy}</p></section>
  <section class="detail-section faq-section"><p class="section-number">04 / FAQ</p><h2>자주 묻는<br /><em>질문.</em></h2>{app.faqs.map(faq => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</section>
  {relatedNotes.length > 0 && <section class="detail-section"><p class="section-number">05 / BEHIND THE BUILD</p><h2>만들면서<br /><em>배운 것.</em></h2><ul class="detail-notes">{relatedNotes.map(note => <li><a class="text-link" href={`/notes/${note.id}/`}>{note.data.title}</a><p>{note.data.description}</p></li>)}</ul></section>}
</InfoLayout>
