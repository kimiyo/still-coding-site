---
import BaseLayout from "../layouts/BaseLayout.astro";
import AppCard from "../components/AppCard.astro";
import AppVisual from "../components/AppVisual.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { apps } from "../data/apps";
import { getNoteCounts, getSortedNotes } from "../lib/notes";
const selected = ["direct-play", "kana-atelier", "vocal-check", "collaboard", "pdf-flow-studio", "bus-explorer", "piano-play", "guitar-auto-strum"].map(id => apps.find(app => app.id === id)!);
const newApps = ["bus-explorer", "piano-play", "vocal-check"].map(id => apps.find(app => app.id === id)!);
const recentNotes = (await getSortedNotes()).slice(0, 4);
const noteCounts = await getNoteCounts();
const description = "생각한 것을, 작동하게 만듭니다. JH Kim이 직접 설계하고 만들고 운영하는 웹 앱과 작은 실험들.";
const structuredData = { "@context": "https://schema.org", "@type": "ItemList", name: "Still Coding — Selected works", numberOfItems: selected.length, itemListElement: selected.map((app, index) => ({ "@type": "ListItem", position: index + 1, name: app.title, url: app.url })) };
---
<BaseLayout title="Still Coding — Ideas, made real." description={description}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <a class="skip-link" href="#apps">작품으로 바로 가기</a>
  <aside class="launch-ticker" aria-label="새로 공개한 앱">
    <div class="ticker-track">
      {[0, 1].map((copy) => <div class="ticker-set" aria-hidden={copy === 1 ? "true" : undefined}>{newApps.map(app => <a href={app.url} target="_blank" rel="noopener noreferrer" tabindex={copy === 1 ? -1 : undefined}><span>NEW RELEASE</span>{app.title}<i aria-hidden="true">↗</i></a>)}</div>)}
    </div>
  </aside>
  <header class="site-header" data-header>
    <a href="#top" class="brand" aria-label="Still Coding 홈"><img class="brand-mark" src="/images/brand/brand-mark.png" width="30" height="30" alt="" /><span>STILL</span><i aria-hidden="true"></i><span>CODING</span></a>
    <span class="header-note">INDEPENDENT DEVELOPER · SEOUL</span>
    <nav aria-label="주요 메뉴"><a href="#apps">Works <sup>{String(selected.length).padStart(2, "0")}</sup></a><a href="#about">About <span aria-hidden="true">↗</span></a><a href="/notes/">개발 노트 <span aria-hidden="true">↗</span></a><LanguageSwitcher locale="ko" /></nav>
  </header>
  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-art" aria-hidden="true"><img src="/images/brand/orbital-study.webp" width="1536" height="1024" alt="" fetchpriority="high" /></div>
      <div class="hero-copy">
        <p class="hero-kicker"><span class="signal-dot"></span> AN INDEPENDENT PRACTICE</p>
        <h1 id="hero-title">생각한 것을,<br /><em>작동하게</em><br class="mobile-break" /> 만듭니다.</h1>
        <p class="hero-description">아이디어와 현실 사이.<br />직접 설계하고, 만들고, 운영하는 작은 세계들.</p>
        <a href="#apps" class="hero-link">작업 보기 <span aria-hidden="true">↓</span></a>
      </div>
      <div class="artifact-label" aria-hidden="true"><span>FIG. 001 — IDEAS IN ORBIT</span><i></i><span>FORM / LOGIC / MOTION</span></div>
      <div class="hero-bottom"><span>JH KIM — DESIGN & DEVELOPMENT</span><span>STILL CURIOUS. STILL CODING.</span><a href="#apps">SCROLL TO DISCOVER <span aria-hidden="true">↓</span></a></div>
    </section>
    <section class="home-intro" aria-labelledby="intro-title">
      <span class="section-number">00 / WHAT IS STILL CODING</span>
      <h2 id="intro-title">브라우저에서 바로 여는<br /><em>작은 도구와 놀이.</em></h2>
      <p>Still Coding은 개인 개발자 JH Kim이 직접 설계하고 만들고 운영하는 웹 앱을 모아 둔 포털입니다. 친구와 링크 하나로 시작하는 게임 모음, 일본어 문자를 쓰고 들으며 익히는 학습 도구, 서버에 자료를 남기지 않는 팀 협업 공간, 버스 노선으로 도시를 읽는 탐색 도구, 글자로 쓴 악보를 피아노로 연주하는 스튜디오, 목소리의 음정을 눈으로 확인하는 연습 도구, 스트로크를 대신해 주는 기타 자동 반주가 있습니다.</p>
      <p>모든 앱은 설치나 회원가입 없이 브라우저에서 열립니다. 각 앱의 상세 안내에서 누구를 위한 도구인지, 처음 시작하는 세 단계, 데이터를 어디에 저장하는지, 자주 묻는 질문을 확인할 수 있습니다. 앱을 만들며 배운 기술과 설계 결정은 <a class="text-link" href="/notes/">개발 노트</a>에 기록합니다.</p>
    </section>
    <section class="projects-section" id="apps" aria-labelledby="apps-title">
      <div class="section-heading"><div><span class="section-number">01 / SELECTED WORKS</span><h2 id="apps-title">Proof of <em>curiosity.</em></h2></div><p>소개 대신, 작동하는 것들.<br />서로 다른 질문에서 시작한 작업들.</p></div>
      <div class="app-grid">{selected.map((app, index) => <AppCard app={app} index={index + 1} noteCount={noteCounts[app.id] ?? 0} />)}</div>
      <p class="works-colophon"><span>CONCEPT → DESIGN → CODE → OPERATION</span><span>여러 개의 작업, 하나의 작업대.</span></p>
    </section>
    <section class="home-notes" aria-labelledby="notes-title">
      <span class="section-number">02 / NOTES FROM THE BENCH</span>
      <h2 id="notes-title">만들면서<br /><em>배운 것.</em></h2>
      <ol class="note-list">{recentNotes.map(note => <li><a href={`/notes/${note.id}/`}><h3>{note.data.title}</h3><p>{note.data.description}</p></a></li>)}</ol>
      <a class="secondary-link" href="/notes/">모든 노트 보기 <span aria-hidden="true">→</span></a>
    </section>
    <section class="about" id="about" aria-labelledby="about-title">
      <span class="section-number">03 / THE PERSON BEHIND</span>
      <div class="about-grid"><div><p class="about-prelude">설명은 짧게. 작업은 계속.</p><h2 id="about-title">Still coding,<br /><em>still curious.</em></h2></div><div class="about-copy"><span class="maker-name">JH Kim <span>INDEPENDENT DEVELOPER</span></span><p>아이디어를 설계하고, 코드로 만들고,<br />직접 운영합니다.</p><p class="about-small">게임에서 학습 도구, 협업 공간까지.<br />관심이 생기면 만들고, 만들면서 더 깊이 이해합니다.</p><a href="https://github.com/kimiyo" target="_blank" rel="noopener noreferrer" aria-label="JH Kim GitHub, 새 창">GitHub에서 이어보기 <span aria-hidden="true">↗</span></a></div></div>
    </section>
  </main>
  <footer>
    <a href="#top" class="footer-brand">STILL / CODING</a>
    <p>IDEAS, MADE REAL.</p>
    <nav class="footer-nav" aria-label="사이트 안내"><a href="/notes/">노트</a><a href="/about/">소개</a><a href="/privacy/">개인정보처리방침</a><a href="/terms/">이용약관</a><a href="/contact/">문의</a></nav>
    <div class="footer-actions">
      <button class="share-button" type="button" data-share aria-describedby="share-status"><span data-share-label>이 사이트 공유하기</span><i aria-hidden="true">↗</i></button>
      <button class="qr-button" type="button" data-qr-open aria-haspopup="dialog" aria-controls="qr-dialog" aria-label="사이트 QR 코드 보기">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h3v3h-3zM18 14h3v7h-3zM14 18h3v3h-3z"/><path d="M5 5h3v3H5zM16 5h3v3h-3zM5 16h3v3H5z" class="qr-cutout"/></svg>
      </button>
    </div>
    <p>© {new Date().getFullYear()} JH KIM · SEOUL</p>
    <span class="sr-only" id="share-status" data-share-status aria-live="polite"></span>
  </footer>
  <dialog class="qr-dialog" id="qr-dialog" data-qr-dialog aria-labelledby="qr-title">
    <div class="qr-dialog-inner">
      <div class="qr-dialog-head"><span>SCAN / CONNECT</span><button type="button" data-qr-close aria-label="QR 코드 닫기">×</button></div>
      <h2 id="qr-title">휴대폰으로<br /><em>이어보기.</em></h2>
      <p>카메라로 QR 코드를 스캔하면<br />Still Coding으로 바로 연결됩니다.</p>
      <div class="qr-code" data-qr-code aria-label="https://still-coding.cc/로 연결되는 QR 코드"></div>
      <div class="qr-url-row"><a href="https://still-coding.cc/">still-coding.cc</a><button type="button" data-copy-url><span data-copy-url-label>주소 복사</span></button></div>
    </div>
  </dialog>
  <script>
    import QRCode from "qrcode";

    const header = document.querySelector<HTMLElement>("[data-header]");
    const updateHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 24);
    updateHeader();
    window.addEventListener("scroll", updateHeader, { passive: true });
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (!motion.matches && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver(entries => entries.forEach(entry => {
        if (entry.isIntersecting) { entry.target.classList.add("arrived"); observer.unobserve(entry.target); }
      }), { threshold: 0.08 });
      document.querySelectorAll(".app-card, .bench-copy, .about-grid").forEach(element => observer.observe(element));
    }

    const shareButton = document.querySelector<HTMLButtonElement>("[data-share]");
    const shareLabel = shareButton?.querySelector<HTMLElement>("[data-share-label]");
    const shareStatus = document.querySelector<HTMLElement>("[data-share-status]");
    const shareUrl = "https://still-coding.cc/";
    const shareTitle = "Still Coding — Ideas, made real.";
    const shareDescription = "브라우저 게임, 학습 도구, 음악·협업·도시 탐색 앱을 만나보세요.";
    const shareText = `${shareTitle}\n${shareDescription}\n${shareUrl}`;
    let resetTimer: number | undefined;

    const copyText = async (text: string) => {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return;
      }
      const textarea = document.createElement("textarea");
      textarea.value = text;
      textarea.style.position = "fixed";
      textarea.style.opacity = "0";
      document.body.appendChild(textarea);
      textarea.select();
      const copied = Reflect.apply(document.execCommand, document, ["copy"]);
      textarea.remove();
      if (!copied) throw new Error("Copy failed");
    };

    const showShareResult = (label: string, announcement: string, state: "success" | "error") => {
      if (!shareButton || !shareLabel) return;
      window.clearTimeout(resetTimer);
      shareLabel.textContent = label;
      shareButton.dataset.state = state;
      if (shareStatus) shareStatus.textContent = announcement;
      resetTimer = window.setTimeout(() => {
        shareLabel.textContent = "이 사이트 공유하기";
        delete shareButton.dataset.state;
      }, 2400);
    };

    shareButton?.addEventListener("click", async () => {
      try {
        const useNativeShare = "share" in navigator && window.matchMedia("(pointer: coarse)").matches;
        if (useNativeShare) {
          await navigator.share({ title: shareTitle, text: shareDescription, url: shareUrl });
          showShareResult("공유했습니다", "사이트를 공유했습니다.", "success");
        } else {
          await copyText(shareText);
          showShareResult("복사되었습니다", "사이트 소개와 주소를 클립보드에 복사했습니다.", "success");
        }
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError") return;
        showShareResult("다시 시도해 주세요", "공유 내용을 복사하지 못했습니다.", "error");
      }
    });

    const qrButton = document.querySelector<HTMLButtonElement>("[data-qr-open]");
    const qrDialog = document.querySelector<HTMLDialogElement>("[data-qr-dialog]");
    const qrCode = document.querySelector<HTMLElement>("[data-qr-code]");
    const qrClose = document.querySelector<HTMLButtonElement>("[data-qr-close]");
    const copyUrlButton = document.querySelector<HTMLButtonElement>("[data-copy-url]");
    const copyUrlLabel = copyUrlButton?.querySelector<HTMLElement>("[data-copy-url-label]");
    let qrReady = false;

    const renderQrCode = async () => {
      if (!qrCode || qrReady) return;
      qrCode.innerHTML = await QRCode.toString(shareUrl, {
        type: "svg",
        width: 248,
        margin: 2,
        errorCorrectionLevel: "M",
        color: { dark: "#101315", light: "#f0ece1" },
      });
      qrReady = true;
    };

    qrButton?.addEventListener("click", async () => {
      if (!qrDialog) return;
      await renderQrCode();
      qrDialog.showModal();
    });
    qrClose?.addEventListener("click", () => qrDialog?.close());
    qrDialog?.addEventListener("click", event => {
      if (event.target === qrDialog) qrDialog.close();
    });
    qrDialog?.addEventListener("close", () => qrButton?.focus());
    copyUrlButton?.addEventListener("click", async () => {
      try {
        await copyText(shareUrl);
        if (copyUrlLabel) copyUrlLabel.textContent = "복사되었습니다";
        if (shareStatus) shareStatus.textContent = "사이트 주소를 클립보드에 복사했습니다.";
        window.setTimeout(() => { if (copyUrlLabel) copyUrlLabel.textContent = "주소 복사"; }, 2000);
      } catch {
        if (copyUrlLabel) copyUrlLabel.textContent = "다시 시도해 주세요";
      }
    });
  </script>
</BaseLayout>
