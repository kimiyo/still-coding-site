---
import InfoLayout from "../../../layouts/InfoLayout.astro";
import { apps } from "../../../data/apps";
import { getAppText, localizedAppUrl, localizedHelpUrl } from "../../../i18n";
export function getStaticPaths() { return apps.filter(app => app.status === "public").map(app => ({ params: { slug: app.id }, props: { app } })); }
const { app: sourceApp } = Astro.props;
const app = getAppText(sourceApp, "en");
const openUrl = localizedAppUrl(sourceApp.url, "en", sourceApp.englishReady);
const guideUrl = localizedHelpUrl(sourceApp, "en");
---
<InfoLayout title={app.title} description={`${app.title} — ${app.summary}`} eyebrow={`STILL CODING / WORK ${String(app.order).padStart(2, "0")}`} locale="en">
  <div class="app-detail-hero" style={`--detail-accent:${app.accent}`}><div><p class="detail-eyebrow">{app.eyebrow}</p><p class="detail-summary">{app.summary}</p><p>{app.detail}</p></div><div class="detail-actions">{openUrl && <a class="primary-link" href={openUrl} target="_blank" rel="noopener noreferrer">Open app <span aria-hidden="true">↗</span></a>}{guideUrl && <a class="secondary-link" href={guideUrl} target="_blank" rel="noopener noreferrer">Open the guide <span aria-hidden="true">↗</span></a>}<a class="secondary-link" href="/en/">View all works</a></div></div>
  {app.id === "guitar-auto-strum" && <section class="detail-section demo-section"><p class="section-number">00 / SEE IT PLAY</p><h2>How it works<br /><em>in 11 seconds.</em></h2><video class="detail-demo-video" src="/videos/guitar-demo.mp4" poster="/images/apps/guitar/demo-poster.jpg" controls muted loop playsinline preload="metadata" aria-label="Demo: tapping chord buttons keeps the strumming going while the fretboard shows the fingering"></video><p class="demo-caption">Tap a chord (C · G · Am · F) and the app keeps the rhythm going. The fretboard on top shows the fingering of the current chord. Unmute the video to hear it.</p></section>}
  <section class="detail-section"><p class="section-number">01 / FOR WHOM</p><h2>Who is this<br /><em>for?</em></h2><p>{app.audience}</p></section>
  <section class="detail-section"><p class="section-number">02 / START IN THREE STEPS</p><h2>Start here<br /><em>if you're new.</em></h2><ol class="step-list">{app.steps.map((step, index) => <li><span>0{index + 1}</span><p>{step}</p></li>)}</ol></section>
  <section class="detail-section"><p class="section-number">03 / DATA & LIMITS</p><h2>Before you use it<br /><em>know this.</em></h2><p>{app.dataPolicy}</p></section>
  <section class="detail-section faq-section"><p class="section-number">04 / FAQ</p><h2>Frequently asked<br /><em>questions.</em></h2>{app.faqs.map(faq => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</section>
</InfoLayout>
