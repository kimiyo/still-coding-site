---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppCard from "../../components/AppCard.astro";
import AppVisual from "../../components/AppVisual.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import { apps } from "../../data/apps";
import { getAppText, localizedAppUrl } from "../../i18n";
const locale = "en" as const;
const selected = ["direct-play", "kana-atelier", "pinhole-lab", "collaboard", "bus-explorer", "piano-play", "vocal-check"].map(id => apps.find(app => app.id === id)!);
const description = "Still Coding is an independent practice by JH Kim: browser games, learning tools, music, collaboration, and urban exploration.";
const structuredData = { "@context": "https://schema.org", "@type": "ItemList", name: "Still Coding — Selected works", numberOfItems: selected.length, itemListElement: selected.map((app, index) => ({ "@type": "ListItem", position: index + 1, name: getAppText(app, locale).title, url: localizedAppUrl(app.url, locale, app.englishReady) })) };
---
<BaseLayout title="Still Coding — Ideas, made real." description={description} locale={locale}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <a class="skip-link" href="#apps">Skip to works</a>
  <header class="site-header" data-header>
    <a href="/en/" class="brand" aria-label="Still Coding home"><span>STILL</span><i aria-hidden="true"></i><span>CODING</span></a>
    <span class="header-note">INDEPENDENT DEVELOPER · SEOUL</span>
    <nav aria-label="Primary navigation"><a href="#apps">Works <sup>{String(selected.length).padStart(2, "0")}</sup></a><a href="#about">About <span aria-hidden="true">↗</span></a><LanguageSwitcher locale={locale} /></nav>
  </header>
  <main id="top">
    <section class="hero" aria-labelledby="hero-title"><div class="hero-art" aria-hidden="true"><img src="/images/brand/orbital-study.webp" width="1536" height="1024" alt="" fetchpriority="high" /></div><div class="hero-copy"><p class="hero-kicker"><span class="signal-dot"></span> AN INDEPENDENT PRACTICE</p><h1 id="hero-title">Make ideas<br /><em>work.</em></h1><p class="hero-description">Between an idea and reality.<br />Small worlds, designed and run directly.</p><a href="#apps" class="hero-link">Explore the work <span aria-hidden="true">↓</span></a></div><div class="artifact-label" aria-hidden="true"><span>FIG. 001 — IDEAS IN ORBIT</span><i></i><span>FORM / LOGIC / MOTION</span></div><div class="hero-bottom"><span>JH KIM — DESIGN & DEVELOPMENT</span><span>STILL CURIOUS. STILL CODING.</span><a href="#apps">SCROLL TO DISCOVER <span aria-hidden="true">↓</span></a></div></section>
    <section class="projects-section" id="apps" aria-labelledby="apps-title"><div class="section-heading"><div><span class="section-number">01 / SELECTED WORKS</span><h2 id="apps-title">Proof of <em>curiosity.</em></h2></div><p>Less talking, more working.<br />Seven projects from different questions.</p></div><div class="app-grid">{selected.map((app, index) => <AppCard app={app} index={index + 1} locale={locale} />)}</div><p class="works-colophon"><span>CONCEPT → DESIGN → CODE → OPERATION</span><span>Seven works, one workbench.</span></p></section>
    <section class="workbench" id="lab" aria-labelledby="lab-title"><div class="bench-copy"><span class="section-number">02 / ON THE WORKBENCH</span><h2 id="lab-title">Not finished.<br /><em>Still exploring.</em></h2><span class="bench-status"><span class="signal-dot"></span> Private experiment · in progress</span><h3>Guitar Auto-Strum</h3><p>A browser guitar where a chord sets the rhythm.<br />An experiment in making movement become music.</p><span class="bench-meta">EXPERIMENT 005 / SOUND & INTERACTION</span></div><div class="bench-art"><AppVisual variant="guitar" title="Guitar Auto-Strum" locale={locale} /><span class="bench-caption">A LITTLE RHYTHM. A NEW POSSIBILITY.</span></div></section>
    <section class="about" id="about" aria-labelledby="about-title"><span class="section-number">03 / THE PERSON BEHIND</span><div class="about-grid"><div><p class="about-prelude">Keep the explanation short. Keep making.</p><h2 id="about-title">Still coding,<br /><em>still curious.</em></h2></div><div class="about-copy"><span class="maker-name">JH Kim <span>INDEPENDENT DEVELOPER</span></span><p>I design ideas, build them in code,<br />and run them directly.</p><p class="about-small">From games and learning tools to collaboration spaces.<br />When curiosity appears, I make something.</p><a href="https://github.com/kimiyo" target="_blank" rel="noopener noreferrer">Continue on GitHub <span aria-hidden="true">↗</span></a></div></div></section>
  </main>
  <footer><a href="/en/" class="footer-brand">STILL / CODING</a><p>IDEAS, MADE REAL.</p><nav class="footer-nav" aria-label="Site information"><a href="/en/about/">About</a><a href="/en/privacy/">Privacy</a><a href="/en/contact/">Contact</a></nav><p>© {new Date().getFullYear()} JH KIM · SEOUL</p></footer>
</BaseLayout>
