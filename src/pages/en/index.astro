---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppCard from "../../components/AppCard.astro";
import AppVisual from "../../components/AppVisual.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import { getAppGroups } from "../../data/apps";
import { getAppText, localizedAppUrl } from "../../i18n";
import { getNoteCounts } from "../../lib/notes";
const locale = "en" as const;
const noteCounts = await getNoteCounts();
let firstNumber = 1;
const groups = getAppGroups().map(group => { const numbered = { ...group, firstNumber }; firstNumber += group.apps.length; return numbered; });
const selected = groups.flatMap(group => group.apps);
const description = "Still Coding is an independent practice by JH Kim: browser games, learning tools, music, collaboration, and urban exploration.";
const structuredData = { "@context": "https://schema.org", "@type": "ItemList", name: "Still Coding — Selected works", numberOfItems: selected.length, itemListElement: selected.map((app, index) => ({ "@type": "ListItem", position: index + 1, name: getAppText(app, locale).title, url: localizedAppUrl(app.url, locale, app.englishReady) })) };
---
<BaseLayout title="Still Coding — Ideas, made real." description={description} locale={locale}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <a class="skip-link" href="#apps">Skip to works</a>
  <header class="site-header" data-header>
    <a href="/en/" class="brand" aria-label="Still Coding home"><img class="brand-mark" src="/images/brand/brand-mark.png" width="30" height="30" alt="" /><span>STILL</span><i aria-hidden="true"></i><span>CODING</span></a>
    <span class="header-note">INDEPENDENT DEVELOPER · SEOUL</span>
    <nav aria-label="Primary navigation"><a href="#apps">Works <sup>{String(selected.length).padStart(2, "0")}</sup></a><a href="#about">About <span aria-hidden="true">↗</span></a><a href="/notes/" hreflang="ko">Dev Notes (KR) <span aria-hidden="true">↗</span></a><LanguageSwitcher locale={locale} /></nav>
  </header>
  <main id="top">
    <section class="hero" aria-labelledby="hero-title"><div class="hero-art" aria-hidden="true"><img src="/images/brand/orbital-study.webp" width="1536" height="1024" alt="" fetchpriority="high" /></div><div class="hero-copy"><p class="hero-kicker"><span class="signal-dot"></span> AN INDEPENDENT PRACTICE</p><h1 id="hero-title">Make ideas<br /><em>work.</em></h1><p class="hero-description">Between an idea and reality.<br />Small worlds, designed and run directly.</p><a href="#apps" class="hero-link">Explore the work <span aria-hidden="true">↓</span></a></div><div class="artifact-label" aria-hidden="true"><span>FIG. 001 — IDEAS IN ORBIT</span><i></i><span>FORM / LOGIC / MOTION</span></div><div class="hero-bottom"><span>JH KIM — DESIGN & DEVELOPMENT</span><span>STILL CURIOUS. STILL CODING.</span><a href="#apps">SCROLL TO DISCOVER <span aria-hidden="true">↓</span></a></div></section>
    <section class="home-intro" aria-labelledby="intro-title"><span class="section-number">00 / WHAT IS STILL CODING</span><h2 id="intro-title">Small tools and games<br /><em>that open in a browser.</em></h2><p>Still Coding is a portal for the web apps that independent developer JH Kim designs, builds, and runs: a game collection you start with a single link, a Japanese kana learning studio, a team collaboration space that keeps materials off the server, a bus route explorer, a text-to-piano score studio, a pitch feedback tool for singers, and an automatic guitar accompaniment.</p><p>Every app opens in a browser without installation or sign-up. Each detail page explains who the app is for, three steps to get started, where data is stored, and common questions.</p></section>
    <section class="projects-section" id="apps" aria-labelledby="apps-title"><div class="section-heading"><div><span class="section-number">01 / SELECTED WORKS</span><h2 id="apps-title">Proof of <em>curiosity.</em></h2></div><p>Less talking, more working.<br />Projects that began from different questions.</p></div><nav class="group-nav" aria-label="App groups">{groups.map(group => <a href={`#group-${group.id}`}>{group.label.en}<sup>{String(group.apps.length).padStart(2, "0")}</sup></a>)}</nav>
      {groups.map((group, groupIndex) => (
        <div class="app-group" id={`group-${group.id}`} aria-labelledby={`group-${group.id}-title`}>
          <div class="group-head"><span class="group-index">{String(groupIndex + 1).padStart(2, "0")}</span><h3 id={`group-${group.id}-title`}>{group.label.en}</h3><p>{group.description.en}</p></div>
          <div class="app-grid">{group.apps.map((app, i) => <AppCard app={app} index={group.firstNumber + i} locale={locale} noteCount={noteCounts[app.id] ?? 0} />)}</div>
        </div>
      ))}<p class="works-colophon"><span>CONCEPT → DESIGN → CODE → OPERATION</span><span>Many works, one workbench.</span></p></section>
    <section class="about" id="about" aria-labelledby="about-title"><span class="section-number">02 / THE PERSON BEHIND</span><div class="about-grid"><div><p class="about-prelude">Keep the explanation short. Keep making.</p><h2 id="about-title">Still coding,<br /><em>still curious.</em></h2></div><div class="about-copy"><span class="maker-name">JH Kim <span>INDEPENDENT DEVELOPER</span></span><p>I design ideas, build them in code,<br />and run them directly.</p><p class="about-small">From games and learning tools to collaboration spaces.<br />When curiosity appears, I make something.</p><a href="https://github.com/kimiyo" target="_blank" rel="noopener noreferrer">Continue on GitHub <span aria-hidden="true">↗</span></a></div></div></section>
  </main>
  <footer><a href="/en/" class="footer-brand">STILL / CODING</a><p>IDEAS, MADE REAL.</p><nav class="footer-nav" aria-label="Site information"><a href="/notes/" hreflang="ko">Notes (KR)</a><a href="/en/about/">About</a><a href="/en/privacy/">Privacy</a><a href="/en/terms/">Terms</a><a href="/en/contact/">Contact</a></nav><p>© {new Date().getFullYear()} JH KIM · SEOUL</p></footer>
</BaseLayout>
