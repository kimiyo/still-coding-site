---
import BaseLayout from "./BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { common, localizedPath, type Locale } from "../i18n";
interface Props { title: string; description: string; eyebrow?: string; locale?: Locale }
const { title, description, eyebrow, locale = "ko" } = Astro.props;
const text = common[locale];
---
<BaseLayout title={title} description={description} locale={locale}>
  <header class="info-header">
    <a href={localizedPath("/", locale)} class="brand" aria-label={text.home}><span>STILL</span><i aria-hidden="true"></i><span>CODING</span></a>
    <nav aria-label={locale === "en" ? "Primary navigation" : "주요 메뉴"}><a href={localizedPath("/", locale)}>{text.works}</a><a href={localizedPath("/about/", locale)}>{text.about}</a><a href={localizedPath("/contact/", locale)}>{text.contact}</a></nav>
  </header>
  <main class="info-main">
    <p class="section-number">{eyebrow ?? text.publicNotes}</p>
    <h1>{title}</h1>
    <slot />
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>
