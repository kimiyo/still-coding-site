---
interface Props {
  variant: "direct-play" | "pinhole" | "kana" | "guitar" | "collaboard" | "bus" | "piano" | "vocal";
  title: string;
  locale?: "ko" | "en";
}

const { variant, title, locale = "ko" } = Astro.props;
const isEnglish = locale === "en";
---

<div class:list={["app-visual", `visual-${variant}`]} aria-label={`${title} ${isEnglish ? "preview" : "미리보기"}`} role="img">
  {variant === "direct-play" && (
    <div class="visual-content direct-content">
      <div class="direct-mini-head"><span class="direct-logo"><i></i><b>{isEnglish ? "DIRECT PLAY" : "다이렉트 플레이"}</b></span><span>PUBLIC ROOM</span></div>
      <div class="direct-tabs"><b>{isEnglish ? "PUBLIC" : "공개방"}</b><span>{isEnglish ? "PRIVATE" : "비밀방"}</span></div>
      <div class="direct-games" aria-hidden="true">
        <span><i>🧩</i><b>{isEnglish ? "Photo Puzzle" : "사진퍼즐게임"}</b><small>{isEnglish ? "Co-op · Puzzle" : "협동 · 퍼즐"}</small></span>
        <span><i>🔢</i><b>{isEnglish ? "Number Baseball" : "숫자 야구"}</b><small>{isEnglish ? "Logic · Guess" : "두뇌 · 추리"}</small></span>
        <span><i>🏎️</i><b>{isEnglish ? "Pocket Race" : "포켓 레이스"}</b><small>{isEnglish ? "Party · Racing" : "파티 · 레이싱"}</small></span>
      </div>
      <strong>CHOOSE · INVITE · PLAY</strong>
    </div>
  )}
  {variant === "pinhole" && (
    <div class="visual-content pinhole-content">
      <span class="visual-label">PINHOLE <em>LAB</em></span>
      <div class="lab-games" aria-hidden="true">
        <div class="lab-game lab-observe"><small>GAME / 01 · OBSERVE</small><span class="pinhole-lens">?</span><b>PINHOLE</b></div>
        <div class="lab-game lab-calculate"><small>GAME / 02 · CALCULATE</small><span class="sum-stack"><i>4</i><i>+</i><i>6</i></span><b>SUM DROP</b></div>
      </div>
      <strong>SMALL RULES. <em>SHARP DECISIONS.</em></strong>
    </div>
  )}
  {variant === "kana" && (
    <div class="visual-content kana-content">
      <div class="kana-mini-head"><span>かな<br /><b>KANA ATELIER</b></span><small><em>1</em> / 149 {isEnglish ? "forms" : "표기"}</small></div>
      <div class="kana-course"><small>{isEnglish ? "One sound, two scripts" : "두 문자를 한 흐름으로"}</small><b><em>あ</em> {isEnglish ? "and" : "와"} <em>ア</em>, {isEnglish ? "the same sound." : "같은 소리로 연결해요."}</b><i>{isEnglish ? "Start lesson" : "통합 학습 시작"}　›</i></div>
      <div class="kana-mark"><span>あ</span><i></i></div>
      <strong>{isEnglish ? <>Listen, speak,<br /><em>learn by hand.</em></> : <>듣고, 말하고,<br /><em>손끝으로 익혀요.</em></>}</strong>
    </div>
  )}
  {variant === "guitar" && (
    <div class="visual-content guitar-content">
      <span class="visual-label">AUTO ACCOMPANIMENT</span>
      <div class="guitar-strings"><i></i><i></i><i></i><i></i><i></i><i></i><b></b></div>
      <div class="chord-row"><span>G</span><span>Em</span><span>C</span><span>D</span></div>
      <strong>GUITAR / IN MOTION</strong>
    </div>
  )}
  {variant === "collaboard" && (
    <div class="visual-content collaboard-content">
      <div class="collaboard-mini-head"><b>🤝 CollaBoard</b><span>PRIVATE P2P SPACE</span></div>
      <div class="collaboard-panes" aria-hidden="true">
        <section><small>🚀 {isEnglish ? "Create team room" : "새 팀 룸 만들기"}</small><div class="room-field">{isEnglish ? "Our private room" : "우리 팀 프라이빗 룸"}</div><div class="tool-grid"><i>🎨</i><i>💡</i><i>❓</i><i>📚</i><i>🗳️</i><i>📁</i><i>📢</i><i>💬</i></div></section>
        <section><small>🔑 {isEnglish ? "Join existing room" : "기존 팀 룸 참여"}</small><div class="room-field muted">ABCD–1234</div><div class="join-button">{isEnglish ? "Join room" : "룸 입장하기"}</div></section>
      </div>
      <strong>SHARE WITH THE TEAM, <em>NOT THE SERVER.</em></strong>
    </div>
  )}
  {variant === "bus" && (
    <div class="visual-content bus-content">
      <div class="transit-head"><b>BUS / EXPLORER</b><span>LIVE ROUTE</span></div>
      <div class="route-map" aria-hidden="true"><i></i><i></i><i></i><i></i><span>273</span></div>
      <strong>FOLLOW THE LINE.<br /><em>FIND THE CITY.</em></strong>
    </div>
  )}
  {variant === "piano" && (
    <div class="visual-content piano-content">
      <span class="visual-label">PIANO / PLAY</span>
      <div class="piano-display"><small>NOW PLAYING</small><b>C<span>4</span></b><i></i></div>
      <div class="piano-keys" aria-hidden="true">{Array.from({ length: 8 }).map(() => <i></i>)}</div>
      <strong>PRESS A KEY. <em>MAKE A SOUND.</em></strong>
    </div>
  )}
  {variant === "vocal" && (
    <div class="visual-content vocal-content">
      <div class="vocal-head"><b>VOCAL CHECK</b><span>● LISTENING</span></div>
      <div class="pitch-readout"><small>CURRENT NOTE</small><b>A<sup>4</sup></b><span>440.0 <i>Hz</i></span></div>
      <div class="pitch-wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <strong>SEE YOUR <em>VOICE.</em></strong>
    </div>
  )}
</div>
