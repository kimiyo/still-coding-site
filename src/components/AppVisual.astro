---
import { directPlayGames } from "../data/directPlayGames";

interface Props {
  variant: "direct-play" | "kana" | "guitar" | "collaboard" | "bus" | "piano" | "vocal" | "pdf";
  title: string;
  locale?: "ko" | "en";
}

const { variant, title, locale = "ko" } = Astro.props;
const isEnglish = locale === "en";
const lang = isEnglish ? "en" : "ko";
---

<div class:list={["app-visual", `visual-${variant}`]} aria-label={variant === "direct-play" ? (isEnglish ? `${title} preview: ${directPlayGames.length} games shown in turn` : `${title} 미리보기: ${directPlayGames.length}개 게임을 차례로 소개`) : `${title} ${isEnglish ? "preview" : "미리보기"}`} role="img">
  {variant === "direct-play" && (
    <div class="visual-content dp-spotlight" data-dp-spotlight>
      <div class="dp-slides">
        {directPlayGames.map((game, index) => (
          <figure class:list={["dp-slide", index === 0 && "is-active"]} data-dp-slide>
            <img src={index === 0 ? game.image : undefined} data-src={game.image} alt="" width="880" height="495" decoding="async" />
            <figcaption class="dp-panel">
              <small>{game.tags[lang]}</small>
              <b>{game.title[lang]}</b>
              <span>{game.pitch[lang]}</span>
              <em><i>{isEnglish ? `${game.players[0]}–${game.players[1]} players` : `${game.players[0]}–${game.players[1]}명`}</i><i>{isEnglish ? `~${game.minutes} min` : `약 ${game.minutes}분`}</i></em>
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="dp-bar">
        <span class="direct-logo"><i></i><b>DIRECT PLAY</b></span>
        <span class="dp-count"><b data-dp-index>01</b> / {String(directPlayGames.length).padStart(2, "0")}</span>
      </div>
      <ol class="dp-rail">
        {directPlayGames.map((game, index) => <li class:list={[index === 0 && "is-active"]} data-dp-dot><img src={game.icon} alt="" width="28" height="28" loading="lazy" /><b></b></li>)}
      </ol>
    </div>
  )}
  {variant === "kana" && (
    <div class="visual-content kana-content">
      <div class="kana-mini-head"><span>かな<br /><b>KANA ATELIER</b></span><small><em>1</em> / 149 {isEnglish ? "forms" : "표기"}</small></div>
      <div class="kana-course"><small>{isEnglish ? "One sound, two scripts" : "두 문자를 한 흐름으로"}</small><b><em>あ</em> {isEnglish ? "and" : "와"} <em>ア</em>, {isEnglish ? "the same sound." : "같은 소리로 연결해요."}</b><i>{isEnglish ? "Start lesson" : "통합 학습 시작"}　›</i></div>
      <div class="kana-mark"><span>あ</span><i></i></div>
      <strong>{isEnglish ? <>Listen, speak,<br /><em>learn by hand.</em></> : <>듣고, 말하고,<br /><em>손끝으로 익혀요.</em></>}</strong>
    </div>
  )}
  {variant === "guitar" && (
    <div class="visual-content guitar-content">
      <span class="visual-label">AUTO ACCOMPANIMENT</span>
      <div class="guitar-strings"><i></i><i></i><i></i><i></i><i></i><i></i><b></b></div>
      <div class="chord-row"><span>G</span><span>Em</span><span>C</span><span>D</span></div>
      <strong>GUITAR / IN MOTION</strong>
    </div>
  )}
  {variant === "collaboard" && (
    <div class="visual-content collaboard-content">
      <div class="collaboard-mini-head"><b>🤝 CollaBoard</b><span>PRIVATE P2P SPACE</span></div>
      <div class="collaboard-panes" aria-hidden="true">
        <section><small>🚀 {isEnglish ? "Create team room" : "새 팀 룸 만들기"}</small><div class="room-field">{isEnglish ? "Our private room" : "우리 팀 프라이빗 룸"}</div><div class="tool-grid"><i>🎨</i><i>💡</i><i>❓</i><i>📚</i><i>🗳️</i><i>📁</i><i>📢</i><i>💬</i></div></section>
        <section><small>🔑 {isEnglish ? "Join existing room" : "기존 팀 룸 참여"}</small><div class="room-field muted">ABCD–1234</div><div class="join-button">{isEnglish ? "Join room" : "룸 입장하기"}</div></section>
      </div>
      <strong>SHARE WITH THE TEAM, <em>NOT THE SERVER.</em></strong>
    </div>
  )}
  {variant === "bus" && (
    <div class="visual-content bus-content">
      <svg class="bus-map" viewBox="0 0 560 440" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="560" height="440" fill="#e4eef9" />
        <path d="M-20 330 C120 270 210 380 330 320 S520 250 600 290" stroke="#bfe6e0" stroke-width="54" fill="none" />
        <g fill="#f5f3eb"><rect x="34" y="38" width="120" height="78" rx="14" /><rect x="190" y="30" width="150" height="62" rx="14" /><rect x="390" y="56" width="130" height="96" rx="14" /><rect x="40" y="160" width="96" height="92" rx="14" /><rect x="400" y="190" width="120" height="58" rx="14" /><rect x="180" y="380" width="140" height="50" rx="14" /></g>
        <g stroke="#fff" stroke-width="12" fill="none" opacity=".9"><path d="M-10 140 L570 128" /><path d="M168 -10 L176 450" /><path d="M370 -10 L360 450" /></g>
        <g fill="none" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"><path d="M40 300 L176 232 L270 232 L360 150 L520 120" stroke="#1d4f9c" /><path d="M90 70 L176 140 L176 232 L240 330 L420 360" stroke="#17b8a6" /><path d="M300 40 L360 150 L470 270 L540 300" stroke="#e77854" /></g>
        <g fill="#fff" stroke-width="5"><circle cx="40" cy="300" r="10" stroke="#1d4f9c" /><circle cx="270" cy="232" r="10" stroke="#1d4f9c" /><circle cx="520" cy="120" r="10" stroke="#1d4f9c" /><circle cx="90" cy="70" r="10" stroke="#17b8a6" /><circle cx="420" cy="360" r="10" stroke="#17b8a6" /><circle cx="300" cy="40" r="10" stroke="#e77854" /><circle cx="540" cy="300" r="10" stroke="#e77854" /></g>
        <g class="bus-transfer" fill="none" stroke="#1d4f9c" stroke-width="3"><circle cx="176" cy="232" r="14" /><circle cx="360" cy="150" r="14" /></g>
        <g fill="#fff" stroke="#14211f" stroke-width="5"><circle cx="176" cy="232" r="14" /><circle cx="360" cy="150" r="14" /></g>
        <g class="bus-vehicle"><g transform="translate(206 300) rotate(-3)"><rect width="74" height="44" rx="12" fill="#1d4f9c" /><rect x="10" y="8" width="54" height="16" rx="4" fill="#dff1ff" /><circle cx="18" cy="37" r="5" fill="#fff" /><circle cx="56" cy="37" r="5" fill="#fff" /></g></g>
        <image href="/images/apps/bus-explorer/pin.webp" x="322" y="34" width="84" height="84" />
      </svg>
      <div class="bus-guide">
        <small>{isEnglish ? "GUIDE · EVERY CITY" : "이용 가이드 · 모든 도시 공통"}</small>
        <b>{isEnglish ? <>Any city,<br /><em>three choices</em> to ride.</> : <>어느 도시든,<br /><em>세 번의 선택</em>이면 돼요.</>}</b>
        <ol>
          <li><i>1</i>{isEnglish ? "Pick a city" : "도시 고르기"}</li>
          <li><i>2</i>{isEnglish ? "Find your bus" : "탈 버스 찾기"}</li>
          <li><i>3</i>{isEnglish ? "Plan the way" : "갈 길 정하기"}</li>
        </ol>
      </div>
      <span class="bus-caption">{isEnglish ? "Illustration · not a real map" : "설명을 위한 예시 그림"}</span>
    </div>
  )}
  {variant === "piano" && (
    <div class="visual-content piano-content">
      <span class="visual-label">PIANO / PLAY</span>
      <div class="piano-display"><small>NOW PLAYING</small><b>C<span>4</span></b><i></i></div>
      <div class="piano-keys" aria-hidden="true">{Array.from({ length: 8 }).map(() => <i></i>)}</div>
      <strong>PRESS A KEY. <em>MAKE A SOUND.</em></strong>
    </div>
  )}
  {variant === "vocal" && (
    <div class="visual-content vocal-content">
      <div class="vocal-head"><b>VOCAL CHECK</b><span>● LISTENING</span></div>
      <div class="pitch-readout"><small>CURRENT NOTE</small><b>A<sup>4</sup></b><span>440.0 <i>Hz</i></span></div>
      <div class="pitch-wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <strong>SEE YOUR <em>VOICE.</em></strong>
    </div>
  )}
  {variant === "pdf" && (
    <div class="visual-content pdf-content">
      <div class="pdf-head"><b>PDF FLOW STUDIO</b><span>{isEnglish ? "IN BROWSER RAM" : "브라우저 메모리"}</span></div>
      <div class="pdf-stage-preview" aria-hidden="true">
        <div class="pdf-page-card"><i>01</i><span></span></div>
        <div class="pdf-flow-arrow">➔</div>
        <div class="pdf-page-card is-active"><i>02</i><span></span></div>
        <div class="pdf-flow-arrow">➔</div>
        <div class="pdf-page-card"><i>03</i><span></span></div>
      </div>
      <strong>{isEnglish ? <>REARRANGE & MERGE, <br /><em>100% PRIVATE.</em></> : <>순서 변경부터 결합까지, <br /><em>서버 전송 없이 안전하게.</em></>}</strong>
    </div>
  )}
</div>

<script>
  // Direct Play 미리보기: 진행 막대 애니메이션이 끝날 때마다 다음 게임으로 넘긴다.
  // 멈춤(마우스 올림·포커스·화면 밖·멈춤 버튼)은 CSS animation-play-state 로 처리하고,
  // prefers-reduced-motion 에서는 애니메이션이 꺼져 첫 게임에 머문다.
  document.querySelectorAll<HTMLElement>("[data-dp-spotlight]").forEach(root => {
    const slides = [...root.querySelectorAll<HTMLElement>("[data-dp-slide]")];
    const dots = [...root.querySelectorAll<HTMLElement>("[data-dp-dot]")];
    const counter = root.querySelector<HTMLElement>("[data-dp-index]");
    const toggle = root.closest(".app-card")?.querySelector<HTMLButtonElement>("[data-dp-toggle]");
    let current = 0;

    const load = (index: number) => {
      const image = slides[index]?.querySelector("img");
      if (image && !image.getAttribute("src") && image.dataset.src) image.src = image.dataset.src;
    };
    const show = (index: number) => {
      slides[current]?.classList.remove("is-active");
      dots[current]?.classList.remove("is-active");
      current = index;
      load(current);
      load((current + 1) % slides.length);
      slides[current]?.classList.add("is-active");
      dots[current]?.classList.add("is-active");
      if (counter) counter.textContent = String(current + 1).padStart(2, "0");
    };

    root.addEventListener("animationend", event => {
      if (event.target === dots[current]?.querySelector("b")) show((current + 1) % slides.length);
    });
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(([entry]) => {
        root.classList.toggle("is-offscreen", !entry?.isIntersecting);
        if (entry?.isIntersecting) load((current + 1) % slides.length);
      }).observe(root);
    }
    toggle?.addEventListener("click", () => {
      const paused = root.classList.toggle("is-paused");
      toggle.setAttribute("aria-pressed", String(paused));
    });
  });
</script>
