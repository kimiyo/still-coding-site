{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "still-coding-portfolio",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "still-coding.com",
      "custom_domain": true
    },
    {
      "pattern": "www.still-coding.com",
      "custom_domain": true
    }
  ]
}
